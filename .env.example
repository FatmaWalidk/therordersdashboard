# Google OAuth client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include your site URL (e.g. https://username.github.io)
VITE_GOOGLE_CLIENT_ID=

# Apps Script Web App URL used by the public intake form (/order)
VITE_APPS_SCRIPT_URL=

# Shared secret, must match SHARED_SECRET inside apps-script/Code.gs
VITE_INTAKE_TOKEN=
